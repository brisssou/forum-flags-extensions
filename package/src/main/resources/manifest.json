{
  "name": "HFR - Mes sujets",
  "version": "2.0.0",
  "description": "Vérifie si les sujets drapalisés sur forum.hardware.fr ont de nouveaux messages.",
  "manifest_version": 3,
  "default_locale": "fr",
  "icons": {
    "16": "images/icon.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "action": {
    "default_icon": "images/flag.gif",
    "default_popup": "popup.html",
    "default_title": "HFR - Mes sujets"
  },
  "background": {
    "service_worker": "worker.js",
    "scripts": [
      "worker.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "forum-flags@brisssou"
    }
  },
  "options_ui": {
    "page": "prefs.html",
    "open_in_tab": false
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://forum.hardware.fr/forum1f.php",
    "https://forum.hardware.fr/setperso.php"
  ]
}